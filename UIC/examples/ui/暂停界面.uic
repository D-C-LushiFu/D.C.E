/~ ===========================================================================
   暂停界面.uic —— 判断链 why! / or! / and! / no / stopWhy
   ---------------------------------------------------------------------------
   判断链会在**当前作用域内的每个元素**上逐个求值，
   命中的元素才会执行该分支体。
   =========================================================================== ~/


hello.[暂停遮罩]("ui/pause_bg.png", 640, 360) {
    camera ? "hud"
    scale ? 1
    alpha ? 0
}


/~ ---------- 判断链示例：按当前 scale 分流 ---------- ~/

hello.[按钮]("ui/btn.png", 640, 360) {
    scale ? 8

    why![scale] ? 8 OK
        dp("scale 是 8")
        alpha ? 1

    or![scale] ? 1 OK
        dp("scale 是 1")
        alpha ? 0.8

    and![scale] ? 0.1 OK
        dp("scale 是 0.1")
        alpha ? 0.5

    no
        dp("都不是")
        alpha ? 0.25

    stopWhy
}


/~ ---------- 多值集合：命中任一即可 ---------- ~/

hello.[图标]("ui/icon.png", 200, 200) {
    alpha ? 0.5

    why![0.25,0.5,0.75|alpha] ? OK
        dp("图标透明度在预设集合里")
        angle ? 10

    no
        dp("图标透明度不在集合里")

    stopWhy
}


/~ ---------- whynot 反选 ---------- ~/

hello.[提示]("ui/hint.png", 640, 600) {
    alpha ? 1

    why![alpha] ? 0 whynot OK
        dp("提示可见")
        visible ? true

    no
        dp("提示被隐藏了")

    stopWhy
}


/~ ---------- 判断链里套条件 ---------- ~/

hello.[滑块]("ui/slider.png", 640, 500) {
    scale ? 1

    why![scale] ? 1 OK
        if screenWidth < 1000 {
            scale ? 0.8
        } else {
            scale ? 1.2
        }

    stopWhy
}
