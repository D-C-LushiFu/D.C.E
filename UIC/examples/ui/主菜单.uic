/~ ===========================================================================
   主菜单.uic —— 元素声明 / 样式 / 组广播 / 条件
   ---------------------------------------------------------------------------
   依赖：先加载 主题.uic（因为用到了 #按钮基底 和 #标准缩放）
   =========================================================================== ~/


/~ ---------- 文件内常量（*@） ---------- ~/

*@ 按钮尺寸 ? 0.8


/~ ---------- 文件内样式组（*@） ---------- ~/

*@ 按钮样式 {
    #按钮基底                /~ 引用跨文件超全局 ~/
    scale ? 0.8               /~ 样式内嵌套叠加：0.85 * 0.8 = 0.68 ~/
}

*@ 次级按钮样式 {
    @按钮样式                /~ 文件内样式可以嵌套另一个文件内样式 ~/
    alpha ? 0.75
}


/~ ---------- 元素组声明（*!） ---------- ~/

*! 主菜单按钮 {btn开始, btn设置, btn退出}


/~ ---------- 元素声明 ---------- ~/

hello.[btn开始]("ui/btn.png", 640, 300) {
    @按钮样式
    scale ? @按钮尺寸         /~ 常量当值用 ~/
}

hello.[btn设置]("ui/btn.png", 640, 380) {
    @按钮样式
}

hello.[btn退出]("ui/btn.png", 640, 460) {
    @次级按钮样式
}

/~ 无资源元素：auto 会按资源尺寸填充，没有资源就是 50px ~/
hello.[占位块](auto, auto, auto) {
    alpha ? 0.3
    camera ? "hud"
}


/~ ---------- 面板 ---------- ~/

hello.[面板]("ui/panel.png", 640, 380) {
    #面板基底
    scale ? 1
}

/~ 面板在按钮之后声明 → 让面板沉到按钮底下需要自己调 z，或者调整声明顺序 ~/


/~ ---------- 条件 ---------- ~/

/~ screenWidth 是引擎给的 Lua 全局，直接读 ~/
if screenWidth >= 1280 {
    面板.alpha ? 0.75
} else {
    面板.alpha ? 0.6
}

/~ 嵌套 + 逻辑组合。注意：这里改的是 angle，不要动 alpha，
   否则会盖掉下面那次组广播的结果 —— UIC 是顺序敏感的。 ~/
if screenWidth >= 1280 && screenHeight >= 720 {
    if btn开始.scale.x == 0.8 {
        btn开始.angle ? 5
    }
} else {
    btn开始.scale ? 0.6
}


/~ ---------- 组广播：一次性，后来者居上 ---------- ~/
/~ 放在条件之后，让它成为 alpha 的最终结果 ~/

主菜单按钮.alpha ? 1
主菜单按钮.alpha ? 0.95        /~ 后一次覆盖前一次 ~/


/~ ---------- 调试输出（dp 等价 debugPrint）---------- ~/

dp("主菜单已构建")
dp(btn开始)
dp(btn开始.scale)
